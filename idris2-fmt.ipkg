package idris2-fmt
version = 0.14.0
authors = "Rune"
sourcedir = "src"
modules = IdrisFmt.AST
        , IdrisFmt.Align
        , IdrisFmt.Blocks
        , IdrisFmt.Comments
        , IdrisFmt.Config
        , IdrisFmt.ConfigFile
        , IdrisFmt.Doc
        , IdrisFmt.IndentFix
        , IdrisFmt.Layout
        , IdrisFmt.Measure
        , IdrisFmt.Monad
        , IdrisFmt.Printer.Monadic
        , IdrisFmt.Printer.Configurable
        , IdrisFmt.Printer.Complete
        , IdrisFmt.Printer.Core
        , IdrisFmt.Parser
        , IdrisFmt.Printer
        , IdrisFmt.Transform
        , IdrisFmt.Version
        , Main
main = Main
executable = idris2-fmt
depends = prettier
        , idris2
        , optparse-applicative
